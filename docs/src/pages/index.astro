---
import BaseLayout from "~/layouts/BaseLayout.astro";
import CodeBlock from "~/components/ui/CodeBlock.astro";

const exampleCode = `import { Database, EffectiveProperties } from "@opencdd/opencdd";

const raw = JSON.parse(await fs.readFile("./database.json", "utf8"));
const db = Database.fromJSON(raw);

const root = db.classes.find((c) => c.superclassIrdi === null);
console.log(\`Root: \${root?.preferredName("en")} (\${root?.code})\`);

// Effective properties = declared + inherited
const effective = new EffectiveProperties(db);
for (const prop of effective.propertiesOf(root!)) {
  console.log(\`  - \${prop.code}: \${prop.preferredName("en")}\`);
}`;

const npmSnippet = "npm install @opencdd/opencdd";

const features = [
  {
    n: "01",
    label: "Model",
    title: "Frozen value objects",
    body: "Every CDD entity type — classes, properties, value lists, value terms, units, relations — as an immutable, IRDI-addressable value object inside a single in-memory Database.",
    accent: "teal",
    icon: "model",
  },
  {
    n: "02",
    label: "Read & write",
    title: "Many formats, one model",
    body: "Reads database.json from the Ruby gem and CDDAL plain-text. Emits JSON, YAML, Mermaid class diagrams, and CSV. The same entity graph flows through every format.",
    accent: "lapis",
    icon: "io",
  },
  {
    n: "03",
    label: "Validate",
    title: "Fourteen rules",
    body: "R01–R14 cover IRDI format, hierarchy acyclicity, type-specific shape, reference integrity, and well-formedness. Structured errors, no exceptions for bad data.",
    accent: "hex",
    icon: "validate",
  },
];

const accentMap = {
  teal: { bg: "bg-teal-500/10", text: "text-teal-700", ring: "group-hover:border-teal-300" },
  lapis: { bg: "bg-lapis-500/10", text: "text-lapis-700", ring: "group-hover:border-lapis-300" },
  hex: { bg: "bg-hex-500/10", text: "text-hex-700", ring: "group-hover:border-hex-300" },
};

const stats = [
  { value: "14", label: "validator rules" },
  { value: "8", label: "entity types" },
  { value: "5", label: "export formats" },
  { value: "100%", label: "type-safe" },
];
---

<BaseLayout
  title="opencdd-ts — a TypeScript model for the IEC Common Data Dictionary"
  description="Read, walk, validate, and emit IEC CDD content from TypeScript. The shared model layer between the OpenCDD Browser and Editor."
>
  <div class="paper-grain">
    <article class="space-y-32">

      {/* ─── HERO ─────────────────────────────────────────────── */}
      <section class="hero-atmosphere relative overflow-hidden pt-10 pb-4">
        <div class="stagger space-y-10">
          {/* Eyebrow */}
          <div class="flex items-center gap-3">
            <span class="hex-seal">☱</span>
            <p class="editorial-number">
              opencdd-ts · TypeScript · IEC CDD
            </p>
          </div>

          {/* Headline */}
          <h1 class="font-display max-w-4xl text-[2.75rem] leading-[1.02] tracking-[-0.025em] text-ink-900 sm:text-[3.5rem] lg:text-[4rem]">
            A TypeScript model<br class="hidden sm:block" />
            for the <span class="text-hex-600 italic">IEC Common</span><br class="hidden sm:block" />
            <span class="text-hex-600 italic">Data Dictionary.</span>
          </h1>

          {/* Deck (subtitle) */}
          <p class="max-w-2xl text-lg leading-relaxed text-ink-600">
            The TypeScript port of the Ruby
            <a href="https://opencdd.github.io/opencdd-ruby/" target="_blank" rel="noreferrer noopener" class="text-hex-700 underline decoration-hex-300 underline-offset-2 hover:text-hex-600">opencdd</a>
            gem. Reads CDD data (CDDAL + YAML), walks the four-layer
            ontology, validates against fourteen rules, and emits
            CDDAL, JSON, YAML, Mermaid, and CSV.
          </p>

          {/* CTAs */}
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/docs/"
              class="inline-flex items-center gap-2 rounded-lg bg-hex-500 px-6 py-3 text-sm font-medium text-white shadow-md transition hover:-translate-y-0.5 hover:bg-hex-600 hover:shadow-lg"
            >
              Get started
              <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href="/docs/reference/api/"
              class="inline-flex items-center gap-2 rounded-lg border border-paper-400 bg-paper-50 px-6 py-3 text-sm font-medium text-ink-700 transition hover:-translate-y-0.5 hover:border-paper-500 hover:text-ink-900 hover:shadow-sm"
            >
              API reference
            </a>
            <a
              href="https://github.com/opencdd/opencdd-ts"
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-medium text-ink-600 transition hover:text-ink-900"
            >
              <svg viewBox="0 0 16 16" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
              </svg>
              GitHub
            </a>
          </div>

          {/* Stats strip */}
          <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-paper-300 bg-paper-300/60 sm:grid-cols-4">
            {stats.map((s) => (
              <div class="bg-paper-50 px-5 py-4">
                <dt class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-400">
                  {s.label}
                </dt>
                <dd class="mt-1 font-display text-2xl font-medium text-ink-900">
                  {s.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      {/* ─── Hexagram divider ─────────────────────────────────── */}
      <div class="flex justify-center" aria-hidden="true">
        <div class="hex-divider hex-divider--lg"><span></span></div>
      </div>

      {/* ─── WHAT IS IT ───────────────────────────────────────── */}
      <section class="space-y-12">
        <header class="max-w-2xl space-y-4 stagger">
          <p class="editorial-number">§ 01 · What it is</p>
          <h2 class="font-display text-4xl tracking-[-0.02em] text-ink-900 sm:text-5xl">
            Three primitives.<br />
            <span class="text-ink-400">One model layer.</span>
          </h2>
          <p class="text-base text-ink-600">
            opencdd-ts gives the OpenCDD Browser and Editor a single,
            shared, type-safe way to think about CDD content. Three
            primitives carry the load.
          </p>
        </header>

        <div class="grid gap-5 md:grid-cols-3 stagger">
          {features.map((f) => {
            const a = accentMap[f.accent as keyof typeof accentMap]!;
            return (
              <article class={`group relative rounded-xl border border-paper-300 bg-paper-50 p-6 shadow-xs transition duration-300 hover:-translate-y-1 hover:shadow-md ${a.ring}`}>
                <div class="flex items-center justify-between">
                  <span class={`inline-flex h-10 w-10 items-center justify-center rounded-lg ${a.bg} ${a.text}`}>
                    {f.icon === "model" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                      </svg>
                    )}
                    {f.icon === "io" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                        <ellipse cx="12" cy="5" rx="8" ry="3" />
                        <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
                        <path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                      </svg>
                    )}
                    {f.icon === "validate" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                        <path d="M9 12l2 2 4-4" />
                        <circle cx="12" cy="12" r="9" />
                      </svg>
                    )}
                  </span>
                  <span class="font-display text-xs uppercase tracking-[0.18em] text-ink-400">
                    {f.n}
                  </span>
                </div>
                <p class={`mt-5 text-[10px] font-semibold uppercase tracking-[0.18em] ${a.text}`}>
                  {f.label}
                </p>
                <h3 class="mt-1 font-display text-xl font-medium text-ink-900">
                  {f.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-600">
                  {f.body}
                </p>
              </article>
            );
          })}
        </div>
      </section>

      {/* ─── CODE ─────────────────────────────────────────────── */}
      <section class="space-y-8">
        <header class="max-w-2xl space-y-4">
          <p class="editorial-number">§ 02 · In practice</p>
          <h2 class="font-display text-4xl tracking-[-0.02em] text-ink-900 sm:text-5xl">
            Load once.<br />
            <span class="text-ink-400">Walk every direction.</span>
          </h2>
          <p class="text-base text-ink-600">
            Load a dictionary, find its root class, list the effective
            properties (declared + inherited). The Database is the
            single source of truth; every walker reads from it.
          </p>
        </header>

        <CodeBlock filename="example.ts" lang="typescript" code={exampleCode} />

        <p class="text-sm text-ink-500">
          <a href="/docs/getting-started/" class="text-hex-700 underline decoration-hex-300 underline-offset-2 hover:text-hex-600">
            Read the full getting-started guide →
          </a>
        </p>
      </section>

      {/* ─── INSTALL ─────────────────────────────────────────── */}
      <section class="space-y-8">
        <header class="max-w-2xl space-y-4">
          <p class="editorial-number">§ 03 · Install</p>
          <h2 class="font-display text-4xl tracking-[-0.02em] text-ink-900 sm:text-5xl">
            One package.<br />
            <span class="text-ink-400">Bundler-required.</span>
          </h2>
        </header>

        <CodeBlock filename="npm" lang="bash" code={npmSnippet} />

        <p class="max-w-2xl text-sm leading-relaxed text-ink-500">
          Requires Node.js ≥ 18 and a bundler (Vite, Webpack, esbuild,
          Rollup). The package uses extensionless ESM imports with
          <code class="rounded bg-paper-200 px-1 py-0.5 font-mono text-[0.85em]">moduleResolution: Bundler</code>.
          Released under the MIT license.
        </p>
      </section>

      {/* ─── CLOSING ─────────────────────────────────────────── */}
      <section class="relative overflow-hidden rounded-2xl border border-paper-300 bg-gradient-to-br from-paper-100 to-paper-200 p-10 sm:p-14">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -right-8 -top-8 select-none opacity-[0.06]"
        >
          <svg width="200" height="200" viewBox="0 0 64 64" fill="none">
            <rect x="8" y="10" width="20" height="6" fill="currentColor" class="text-ink-900" />
            <rect x="36" y="10" width="20" height="6" fill="currentColor" class="text-ink-900" />
            <rect x="8" y="28" width="48" height="6" fill="currentColor" class="text-ink-900" />
            <rect x="8" y="46" width="48" height="6" fill="currentColor" class="text-ink-900" />
          </svg>
        </div>
        <div class="relative max-w-2xl space-y-4">
          <p class="editorial-number">Next</p>
          <h2 class="font-display text-3xl tracking-[-0.02em] text-ink-900 sm:text-4xl">
            Start with the ontology.
          </h2>
          <p class="text-base text-ink-600">
            The CDD ontology is unusual: an instance of a categorical
            class is itself a class. That single rule is what makes
            CDD different from UML, RDF, and OWL — and it's where
            every newcomer should begin.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href="/docs/ontology/"
              class="inline-flex items-center gap-2 rounded-lg bg-ink-900 px-5 py-2.5 text-sm font-medium text-paper-100 transition hover:-translate-y-0.5 hover:bg-ink-800 hover:shadow-md"
            >
              Read the ontology overview
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="/docs/"
              class="inline-flex items-center gap-2 rounded-lg border border-paper-400 bg-paper-50 px-5 py-2.5 text-sm font-medium text-ink-700 transition hover:border-paper-500 hover:text-ink-900"
            >
              Browse all docs
            </a>
          </div>
        </div>
      </section>

    </article>
  </div>
</BaseLayout>
