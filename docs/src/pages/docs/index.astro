---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Card from "~/components/ui/Card.astro";

const SECTION_META: Record<string, {
  blurb: string;
  accent: string;
  badge: string;
  glyph: string;
}> = {
  "Getting Started": {
    blurb: "New here? Start with these.",
    accent: "border-lapis-300 bg-lapis-50/40",
    badge: "text-lapis-700 bg-lapis-500/10",
    glyph: "01",
  },
  Concepts: {
    blurb: "Understand the mental model.",
    accent: "border-teal-300 bg-teal-50/40",
    badge: "text-teal-700 bg-teal-500/10",
    glyph: "02",
  },
  Guides: {
    blurb: "Step-by-step recipes.",
    accent: "border-hex-300 bg-hex-50/40",
    badge: "text-hex-700 bg-hex-500/10",
    glyph: "03",
  },
  Reference: {
    blurb: "Detailed specifications and lookup.",
    accent: "border-violet-300 bg-violet-50/30",
    badge: "text-violet-700 bg-violet-500/10",
    glyph: "04",
  },
  Project: {
    blurb: "Contribute to opencdd-ts.",
    accent: "border-paper-400 bg-paper-100/70",
    badge: "text-ink-700 bg-ink-500/10",
    glyph: "05",
  },
};

const SECTION_ORDER = ["Getting Started", "Concepts", "Guides", "Reference", "Project"];

const entries = await getCollection("docs");
const grouped = SECTION_ORDER.map((section) => ({
  section,
  meta: SECTION_META[section]!,
  items: entries
    .filter((d) => d.id !== "index" && d.id !== "index.mdx" && d.data.section === section)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
})).filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Documentation — opencdd-ts"
  description="Guides, references, and deep dives for using @opencdd/opencdd — the TypeScript port of the opencdd Ruby gem."
>
  <div class="paper-grain">
    <article class="mx-auto max-w-6xl px-6 py-14 lg:px-8">

      {/* ─── Page header ─────────────────────────────────────── */}
      <header class="mb-16 stagger">
        <div class="flex items-center gap-3">
          <span class="hex-seal">☱</span>
          <p class="editorial-number">Documentation · opencdd-ts</p>
        </div>
        <h1 class="mt-8 font-display text-[2.75rem] leading-[1.05] tracking-[-0.025em] text-ink-900 sm:text-6xl">
          Guides, references,<br />
          <span class="text-ink-400">and deep dives.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">
          Everything you need to use
          <code class="rounded bg-paper-200 px-1.5 py-0.5 font-mono text-[0.9em] text-ink-800">@opencdd/opencdd</code>
          — load a dictionary, walk the entity graph, validate
          content, emit CDDAL / JSON / YAML.
        </p>
      </header>

      {/* ─── Section grid ────────────────────────────────────── */}
      <div class="space-y-8">
        {grouped.map((group, idx) => (
          <section
            class={`rounded-2xl border p-7 sm:p-9 ${group.meta.accent}`}
          >
            <div class="mb-7 flex items-start justify-between gap-6">
              <div class="space-y-2">
                <p class={`inline-flex items-center gap-2 rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] ${group.meta.badge}`}>
                  <span class="font-display text-sm tracking-normal">{group.meta.glyph}</span>
                  {group.section}
                </p>
                <h2 class="font-display text-2xl tracking-tight text-ink-900 sm:text-3xl">
                  {group.section}
                </h2>
              </div>
              <p class="hidden max-w-xs pt-2 text-sm text-ink-500 sm:block">
                {group.meta.blurb}
              </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((entry) => (
                <Card interactive pad={false} class="h-full">
                  <a
                    href={`/docs/${entry.id.replace(/\.mdx?$/, "")}/`}
                    class="card-link flex h-full flex-col gap-2 p-5"
                  >
                    <h3 class="font-display text-lg font-medium text-ink-900 transition group-hover:text-hex-700">
                      {entry.data.title}
                    </h3>
                    {entry.data.description && (
                      <p class="text-sm leading-relaxed text-ink-500 line-clamp-3">
                        {entry.data.description}
                      </p>
                    )}
                    <span class="mt-auto pt-2 text-[11px] font-medium uppercase tracking-[0.18em] text-hex-600 opacity-0 transition group-hover:opacity-100">
                      Read →
                    </span>
                  </a>
                </Card>
              ))}
            </div>
          </section>
        ))}
      </div>

      {/* ─── Cross-reference footer ─────────────────────────── */}
      <footer class="mt-20 border-t border-paper-300 pt-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-ink-500">
            Looking for the Ruby API? Visit the
            <a
              href="https://opencdd.github.io/opencdd-ruby/"
              target="_blank"
              rel="noreferrer noopener"
              class="text-hex-700 underline decoration-hex-300 underline-offset-2 hover:text-hex-600"
            >opencdd-ruby docs ↗</a>.
          </p>
          <a
            href={`https://github.com/opencdd/opencdd-ts/edit/main/docs/src/content/docs/`}
            target="_blank"
            rel="noreferrer noopener"
            class="text-sm text-ink-500 transition hover:text-ink-900"
          >
            Edit these docs on GitHub →
          </a>
        </div>
      </footer>

    </article>
  </div>
</BaseLayout>
