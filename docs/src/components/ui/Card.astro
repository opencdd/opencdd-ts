---
import { cn } from "~/lib/cn";

interface Props {
  class?: string;
  pad?: boolean;
  /** When true, renders as a link-friendly surface (lifts border into accent on hover). */
  interactive?: boolean;
}

const { class: className, pad = true, interactive = false } = Astro.props;
---

<div
  class={cn(
    "group relative rounded-xl border bg-paper-50 shadow-xs transition duration-300 print:break-inside-avoid print:shadow-none",
    interactive
      ? "border-paper-300 hover:-translate-y-0.5 hover:border-hex-300 hover:shadow-md"
      : "border-ink-200/70 hover:border-paper-300 hover:shadow-sm",
    pad && "p-5",
    className,
  )}
>
  <slot />
</div>
